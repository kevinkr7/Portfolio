{
  "name": "kevin-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node preview-server.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "studio": "vite --open /studio.html",
    "studio:build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "runtime:lock": "node scripts/lock-runtime.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.14"
  }
}
